{
  "name": "kaskita",
  "version": "1.0.0",
  "private": true,
  "description": "KasKita — aplikasi kas kecil & iuran bulanan (React + Express + MongoDB) dalam satu project",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "start": "NODE_ENV=production node server/index.js",
    "seed:reset": "node server/index.js --reset-seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "hono": "^4.13.16",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.66.0",
    "mongoose": "^9.11.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5",
    "wrangler": "^4.156.1"
  }
}
