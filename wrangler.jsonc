{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaskita",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "KASKITA_API",
        "class_name": "KasKitaApi"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KasKitaApi"]
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "SEED_ADMIN_USERNAME": "admin",
    "SEED_SUPERADMIN_USERNAME": "superadmin"
  }
}
